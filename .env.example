#######################################################################
# YOUR DART EXPRESS — ENVIRONMENT CONFIGURATION
#
# Copy this file to `.env.local` for local development, and set the same
# variables in the Hostinger control panel for production.
#
# `.env.local` is git-ignored. NEVER commit real credentials.
# Nothing here is read by the browser except NEXT_PUBLIC_* variables —
# and no secret may ever be given a NEXT_PUBLIC_ prefix.
#######################################################################

# ---------------------------------------------------------------------
# SITE
# ---------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs, Open Graph
# URLs, the sitemap and JSON-LD. Getting this wrong breaks canonical tags.
#   Local:      http://localhost:3000
#   Production: https://yourdartexpress.com
NEXT_PUBLIC_SITE_URL=https://yourdartexpress.com


# ---------------------------------------------------------------------
# SMTP — CONTACT FORM DELIVERY (Hostinger email)
# ---------------------------------------------------------------------
# Server-side only. Read exclusively by lib/mailer.ts, which is marked
# `server-only` so importing it from client code is a build error.
#
# Hostinger SMTP settings (Emails → your domain → Configuration):
#   Host: smtp.hostinger.com
#   Port: 465 with implicit TLS (recommended), or 587 with STARTTLS
#   User: the FULL mailbox address
#   Pass: that mailbox's password
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@yourdartexpress.com
SMTP_PASSWORD=

# Envelope sender. Must be a mailbox you own on this domain, or messages
# will fail SPF/DKIM and land in spam. Defaults to SMTP_USER if unset.
MAIL_FROM=contact@yourdartexpress.com

# Where enquiries are delivered. Can differ from MAIL_FROM.
# Multiple recipients: comma-separate them.
MAIL_TO=contact@yourdartexpress.com


# ---------------------------------------------------------------------
# OPTIONAL — SEARCH CONSOLE
# ---------------------------------------------------------------------
# Only needed if you verify via meta tag instead of the DNS TXT method.
# The DNS method is preferred; see docs/DEPLOYMENT.md.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=


# ---------------------------------------------------------------------
# NOT CONFIGURED — INTENTIONALLY
# ---------------------------------------------------------------------
# There is no analytics key here. The site currently loads no third-party
# scripts at all, which is what the Cookie Policy states and why no cookie
# banner is shown. If analytics is added later, the Cookie Policy and the
# CSP in next.config.ts must both be updated first.


# ---------------------------------------------------------------------
# SHIPMENT TRACKING (optional — /track works without it)
# ---------------------------------------------------------------------
# Until these are set, /api/track returns state:"unavailable" and the
# tracking page says plainly that live lookup is not connected, rather
# than inventing checkpoints. See lib/tracking.ts.
#
# Connecting a carrier is two steps:
#   1. set these two variables
#   2. implement normaliseProviderPayload() for that provider's response
# Nothing in the UI needs to change.
#
# TRACKING_API_URL=https://api.your-carrier.example/v1/shipments
# TRACKING_API_KEY=


# ---------------------------------------------------------------------
# TRACKING DEMO MODE
# ---------------------------------------------------------------------
# Returns a SAMPLE shipment so the tracking result page can be seen and
# demoed before a carrier feed exists. Every sample carries a visible
# "Sample data — not a real shipment" banner.
#
#   unset  -> ON with `next dev`, OFF in a production build (the default)
#   true   -> ON, including in production. Use for a staging demo only.
#   false  -> always OFF
#
# A real carrier feed always wins: if TRACKING_API_URL and TRACKING_API_KEY
# are set, demo mode never runs.
#
# TURN THIS OFF BEFORE LAUNCH unless you deliberately want the sample.
# TRACKING_DEMO_MODE=false
#
# The last digit of the reference picks the scenario, so every state can be
# demonstrated:  ...1 in transit  ...2 delivered  ...3 held  ...4 booked
# anything else -> out for delivery
